PORT=5000
NODE_ENV=production

# MongoDB Connection String (Atlas or Local)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/reachinbox?retryWrites=true&w=majority&appName=Cluster0

# Redis Connection (BullMQ)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
USE_IN_MEMORY_REDIS=true

# Elasticsearch (Optional)
ELASTICSEARCH_NODE=http://127.0.0.1:9200
ELASTICSEARCH_API_KEY=

# Rate Limiting
MAX_EMAILS_PER_HOUR=200
MAX_EMAILS_PER_HOUR_PER_SENDER=50

# Slack Notifications
SLACK_WEBHOOK_URL=

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
